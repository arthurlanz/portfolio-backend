# Copie para .env em desenvolvimento. Em produção, use as variáveis de ambiente da plataforma.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seu-app.fabricadesoftware.ifc.edu.br
# E-mail por SMTP (principal). Exemplo com Gmail: use uma "senha de app" (myaccount.google.com/apppasswords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=
# SendGrid (reserva, opcional): usado só se o SMTP falhar.
SENDGRID_API_KEY=
# Opcional: com um token (sem escopos) o calendário do GitHub fica completo.
GITHUB_TOKEN=
